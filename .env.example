# Copy to .env. Telegram is optional; everything else has a default.
# Requests per second to Kalshi for the download and for the paper maker (the basic tier
# allows about 20 per second, and pm-xarb shares the host).
KM_RATE=6
KM_RATE_PAPER=4
# Paper maker cycle in seconds and number of markets quoted at once.
KM_CYCLE_S=20
KM_MAX_MARKETS=400
# The download stops if free disk falls below this many GB.
KM_MIN_FREE_GB=3
KM_LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
